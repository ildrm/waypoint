{
  "name": "waypoint/assessment-platform",
  "type": "project",
  "description": "Free multilingual adaptive assessments and explainable project estimates",
  "require": {
    "php": "^8.2",
    "ext-bcmath": "*",
    "ext-intl": "*",
    "ext-pdo": "*",
    "laravel/framework": "^12.0",
    "filament/filament": "^5.0",
    "opis/json-schema": "^2.6"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "mockery/mockery": "^1.6",
    "laravel/pint": "^1.24"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "test": "@php vendor/phpunit/phpunit/phpunit",
    "test:unit": "@php vendor/phpunit/phpunit/phpunit",
    "format": "@php vendor/laravel/pint/builds/pint"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {},
    "cache-dir": ".build/composer-cache"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
